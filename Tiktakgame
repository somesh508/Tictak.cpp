
#include <iostream>
using namespace std;

char board[3][3] = {
    {'1', '2', '3'},
    {'4', '5', '6'},
    {'7', '8', '9'}
};

void displayboard() {

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cout << " " << board[i][j] << " ";

            if (j < 2) {
                cout << "|";
            }
        }

        cout << endl;

        if (i < 2) {
            cout << "---+---" << endl;
        }
    }
}

bool winner() {

    for (int i = 0; i < 3; i++) {

        if (board[i][0] == board[i][1] &&
            board[i][1] == board[i][2]) {
            return true;
        }

        if (board[0][i] == board[1][i] &&
            board[1][i] == board[2][i]) {
            return true;
        }
    }

    if (board[0][0] == board[1][1] &&
        board[1][1] == board[2][2]) {
        return true;
    }

    if (board[0][2] == board[1][1] &&
        board[1][1] == board[2][0]) {
        return true;
    }

    return false;
}

int main() {

    int choice;
    int moves = 0;
    char player = 'x';

    cout << "------welcome to the tik tak game------";

    while (true) {

        cout << "\nenter position(1-9)";
        cin >> choice;

        if (choice < 1 || choice > 9) {
            cout << "invalid choice";
            continue;
        }

        int row = (choice - 1) / 3;
        int col = (choice - 1) % 3;

        if (board[row][col] == 'x' ||
            board[row][col] == '0') {
            continue;
        }

        board[row][col] = player;
        moves++;

        if (winner()) {
            displayboard();
            cout << "wins";
            break;
        }

        if (moves == 9) {
            displayboard();
            cout << "stop";
            break;
        }

        if (player == 'x') {
            player = '0';
        }
        else {
            player = 'x';
        }
    }

    return 0;
}
